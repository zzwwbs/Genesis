{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecificationPatch",
  "type": "object",
  "properties": {
    "stage_id": {
      "type": "string"
    },
    "base_specification_version": {
      "type": "integer"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "replace",
              "remove"
            ]
          },
          "path": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "op",
          "path"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "source_turns": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "target"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "statement"
        ],
        "additionalProperties": false
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_checklist_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "stage_id",
    "base_specification_version",
    "operations"
  ]
}
