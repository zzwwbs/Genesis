{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssistantEvaluation",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "needs_clarification",
        "ready_to_draft"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_turns": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "claim"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "decision_id": {
            "type": "string"
          },
          "target_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "consequential": {
            "type": "boolean"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          }
        },
        "required": [
          "id",
          "decision_id",
          "target_paths",
          "question",
          "reason",
          "consequential"
        ]
      }
    },
    "decision_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["unresolved", "covered", "defaulted"]
          },
          "evidence_turns": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": ["decision_id", "status", "evidence_turns"]
      }
    },
    "checklist_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "proposed_status": {
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "proposed_status"
        ]
      }
    }
  },
  "required": [
    "status",
    "summary",
    "decision_coverage"
  ]
}
